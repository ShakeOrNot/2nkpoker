# 2nkpoker 环境变量（全项目只此一份）
# 用法：cp .env.example .env  然后按需修改；.env 不进 Git。
#
# 后端 / 脚本 / 启动器都读这一份：
#   - 后端：apps/game-server/src/env.js（按文件位置定位，不依赖启动目录）
#   - 脚本：scripts/*.js（dotenv）
#   - 启动器：start.mjs

# 后端端口
PORT=3001
# 前端静态站端口
WEB_PORT=8080

# JWT：开发环境由 game-server 的 POST /dev/token 自己签发；生产必须换成强随机值
JWT_SECRET=dev_secret_change_me
JWT_ISSUER=2nkpoker
JWT_AUDIENCE=2nkpoker-web

# 轮到某人行动后的超时（毫秒，超时自动过牌/弃牌）
ACTION_TIMEOUT_MS=30000
# 掉线后保留座位/筹码的宽限期（毫秒）
RECONNECT_GRACE_MS=30000
# 一手结束后停多久再开下一手（毫秒，留给前端结算动画）
SETTLE_HOLD_MS=2500