# 2nkpoker 环境变量（全项目只此一份）
# 用法：cp .env.example .env  然后按需修改；.env 不进 Git。
#
# 后端 / 脚本 / 启动器都读这一份：
#   - 后端：apps/game-server/src/env.js（按文件位置定位，不依赖启动目录）
#   - 脚本：scripts/*.js（dotenv）
#   - 启动器：start.mjs

# 后端端口
PORT=3001
# 前端静态站端口
WEB_PORT=8080

# JWT：开发环境由 game-server 的 POST /dev/token 自己签发；生产必须换成强随机值
JWT_SECRET=dev_secret_change_me
JWT_ISSUER=2nkpoker
JWT_AUDIENCE=2nkpoker-web

# 轮到某人行动后的超时（毫秒，超时自动过牌/弃牌）
ACTION_TIMEOUT_MS=30000
# 掉线后保留座位/筹码的宽限期（毫秒）
RECONNECT_GRACE_MS=30000
# 一手结束后停多久再开下一手（毫秒，留给前端结算动画）
SETTLE_HOLD_MS=2500
# 翻牌/转牌/河牌之间停多久（毫秒，留给前端动画）
STREET_DELAY_MS=1000
# ---------- 账密系统 ----------
# 部署在 Nginx/Caddy 等反向代理后面时设为 1（或 loopback），让限流/审计拿到真实 IP
# 本地直连保持注释即可
# TRUST_PROXY=1

# 用户库（SQLite）。默认仓库根 var/2nkpoker.db，一般不用改
# AUTH_DB_PATH=var/2nkpoker.db
# access token 有效期（毫秒），默认 15 分钟
ACCESS_TTL_MS=900000
# 刷新令牌有效期（毫秒），默认 7 天
REFRESH_TTL_MS=604800000
# 开发用 POST /dev/token（生产环境始终关闭）
ALLOW_DEV_TOKEN=1
# 登录失败限制：同账号 5 次锁 5 分钟；同 IP 5 分钟内最多 20 次失败
AUTH_MAX_ATTEMPTS=5
AUTH_LOCK_MS=300000
AUTH_WINDOW_MS=300000
AUTH_IP_MAX_ATTEMPTS=20