# 服务器/本地共用的行为参数（不包含密钥）
# 用 `node scripts/sync-env.mjs` 把这些值同步到目标 .env，其余行原样保留。
ACTION_TIMEOUT_MS=30000
RECONNECT_GRACE_MS=30000
SETTLE_HOLD_MS=5000
STREET_DELAY_MS=1200
RUNOUT_BOARD_MS=3000
RUNOUT_TIMEOUT_MS=30000
SHOW_CARDS_MS=5000
ACCESS_TTL_MS=900000
REFRESH_TTL_MS=604800000
AUTH_MAX_ATTEMPTS=5
AUTH_LOCK_MS=300000
AUTH_WINDOW_MS=300000
AUTH_IP_MAX_ATTEMPTS=20
